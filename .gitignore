# Виртуальное окружение Python (у каждого создаётся своё)
.venv/
__pycache__/

# Демки и временные файлы — они большие и личные
*.dem
*.dem.gz
*.dem.zst
uploads/

# Картинки радаров — это файлы из игры Valve, у каждого скачиваются через awpy
static/maps/

# Результаты скрипта
*.csv

# Секреты (API-ключи FACEIT и т.п.) — НИКОГДА не выкладываем
.env

# Настройки редактора
.vscode/
